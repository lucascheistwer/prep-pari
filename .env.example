# Copiá este archivo a .env solo si vas a correr procesos en el host.
# Docker Compose ya trae valores locales y no necesita este archivo.
# No pongas claves reales. El proveedor de IA de la Fase 0 es fake.

PREPPARI_RUNTIME_MODE=api
PREPPARI_RUN_MIGRATIONS=true
PORT=8080

SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/preppari
SPRING_DATASOURCE_USERNAME=preppari
SPRING_DATASOURCE_PASSWORD=preppari
PREPPARI_DB_POOL_SIZE=5

# Reservado para Pub/Sub en una fase posterior. La app todavía no se conecta.
REDIS_URL=redis://localhost:6379

# Solo "fake" arranca. El nombre del modelo se elige por ambiente y puede quedar vacío.
PREPPARI_AI_PROVIDER=fake
PREPPARI_AI_TEXT_MODEL=
PREPPARI_AI_IMAGE_MODEL=
PREPPARI_AI_IMAGE_ENABLED=false

# Reservada para la Fase 2. No la completes en el repositorio.
PREPPARI_AI_API_KEY=

# Opcional. Si queda vacío, cada proceso de worker genera un id propio.
PREPPARI_WORKER_ID=
PREPPARI_WORKER_BATCH_SIZE=5
PREPPARI_WORKER_LEASE=60s

# Sesión propia, firmada en el backend después de validar Google. Mínimo 32 bytes.
# En el perfil local hay un valor de desarrollo si esta variable queda vacía.
# En producción es obligatoria y no puede ser ese valor de desarrollo.
PREPPARI_SESSION_SECRET=
PREPPARI_SESSION_TTL=7d
PREPPARI_PUBLIC_ORIGIN=http://localhost:3000

# Login con Google (Google Identity Services). El Client ID es público.
# El flujo elegido no usa client secret: el frontend recibe un ID token y el
# backend lo valida contra el issuer y los certificados de Google.
GOOGLE_CLIENT_ID=41982195732-fjbpba5jmj78mtld1bol0l690j6n4q5p.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Solo si el frontend no corre en la misma máquina que la API.
API_URL=http://localhost:8080
